{
  "manifest_version": 3,
  "name": "YTS Download Button",
  "version": "1.0.0",
  "description": "A Chrome extension that replaces the download button on YTS with a custom button",
  "action": {
    "default_popup": "index.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*/*"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "permissions": [
    "tabs"
  ],
  "host_permissions": [
    "https://192.168.50.63:3000/*"
  ]
}
